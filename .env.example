# Supabase (Phase 1+)
# Copy to .env.local and fill with values from the Supabase project settings.
# Never commit real secrets.

# Project URL — safe for the browser
NEXT_PUBLIC_SUPABASE_URL=

# Client-safe API key (Dashboard: anon / publishable key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional alias used by newer Supabase docs (same client-safe key)
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only — bypasses RLS. Never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Mux (Phase 9+) — server-only. Never prefix with NEXT_PUBLIC_
# Dashboard: https://dashboard.mux.com/settings/access-tokens
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# Phase 11 — Mux Dashboard → Settings → Webhooks
# URL: https://YOUR_DOMAIN/api/webhooks/mux
# (local: use ngrok / Cloudflare Tunnel pointing here)
# Also requires SUPABASE_SERVICE_ROLE_KEY above so the webhook can update rows.
MUX_WEBHOOK_SECRET=
# Alias some Mux docs use:
# MUX_WEBHOOK_SIGNING_SECRET=

# Public site origin — used for canonical URLs, Open Graph, sitemap, and Mux CORS
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Auth setup (Phase 3) ---
# 1. Supabase Dashboard → Authentication → Users → Add user
# 2. Create the site owner with email + password (auto-confirm)
# 3. Authentication → URL configuration: add http://localhost:3000
#    (and your production origin when deployed)
# 4. Sign in at /admin/login
